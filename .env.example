# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456789:AA...

# Google AI Studio key (primary provider): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter key (fallback provider): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Primary Gemini model (gemini-2.5-* uses thinking budgets, gemini-3* uses thinking levels)
PRIMARY_GEMINI_MODEL=gemini-2.5-flash

# Comma-separated OpenRouter fallback chain (max 3 models are used).
# Paid example (cheap reasoning + image input):
# OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-v4.1-flash-1017,deepseek/deepseek-v4-flash,openrouter/free
# Output cap per OpenRouter request, reasoning included (protects paid budgets):
# OPENROUTER_MAX_TOKENS=24000
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openrouter/free

# Access control (send /id to the bot to learn the IDs). Comma-separated.
# Empty both = bot is open to everyone.
# ALLOWED_USER_IDS — owners: always allowed, may add the bot to new groups.
# ALLOWED_CHAT_IDS — groups where the bot works; their members can also use it in private.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# Optional
# PORT=10000
# LOG_LEVEL=INFO

# Self-ping keep-alive. On Render the URL comes from RENDER_EXTERNAL_URL automatically;
# set SELF_PING_URL only to override it. Interval in seconds (60..840), 0 disables.
# SELF_PING_URL=https://your-service.onrender.com
# SELF_PING_INTERVAL=600
